# Local development only. Run scripts/setup-local.ps1 to generate an ignored .env.
FLOWPAY_DATABASE_PASSWORD=
FLOWPAY_HTTP_PORT=8080
FLOWPAY_LOGIN_RATE=5r/m
FLOWPAY_DEMO_RATE=2r/m

# Optional conventional operator, created only by scripts/provision-local.ps1.
# Supply your own values. Never commit a real password or enable this in production.
FLOWPAY_BOOTSTRAP_COMPANY_NAME=
FLOWPAY_BOOTSTRAP_EMAIL=
FLOWPAY_BOOTSTRAP_PASSWORD=
